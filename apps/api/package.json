{
  "name": "@mando/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test tsx --test src/**/*.test.ts",
    "db:check": "tsx src/db/check-connection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:migrate": "NODE_ENV=test DATABASE_TARGET=test DOTENV_CONFIG_PATH=.env.test drizzle-kit migrate",
    "db:test:check": "NODE_ENV=test DATABASE_TARGET=test DOTENV_CONFIG_PATH=.env.test tsx src/db/check-connection.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:catalog": "tsx src/db/seed-catalog.ts",
    "db:seed:test-staff": "tsx src/db/seed-test-staff.ts",
    "db:seed:test-downlines": "tsx src/db/seed-test-downlines.ts",
    "db:seed:superadmin": "tsx src/db/seed-superadmin.ts",
    "db:seed:promo-combos": "tsx src/db/seed-promo-combos.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
