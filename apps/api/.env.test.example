# Copy this file to apps/api/.env.test and use a separate Neon branch/database.
# Never paste the production DATABASE_URL here.
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=verify-full
SESSION_SECRET=test-only-session-secret-change-me
PAYOUT_ACCOUNT_ENCRYPTION_KEY=test-only-payout-key-change-me
